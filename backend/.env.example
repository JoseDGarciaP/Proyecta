# PostgreSQL local (docker compose up -d db) o la cadena de conexión de Supabase
DATABASE_URL=postgresql+psycopg://proyecta:proyecta@localhost:5432/proyecta
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Dominios de correo permitidos para registrarse (separados por coma). Vacío = cualquiera.
ALLOWED_EMAIL_DOMAINS=ufpso.edu.co
CORS_ORIGINS=http://localhost:5173
# IA: ollama (local y gratuito), anthropic (Claude, de pago) o reglas (sin modelo).
# Si el proveedor no responde, el resumen sale de reglas locales y se marca como simulado.
IA_PROVEEDOR=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Similitud semántica (perfiles, proyectos, oportunidades) con sentence-transformers.
# El modelo se descarga al primer uso. Con false se usa similitud por palabras en común.
EMBEDDINGS_ACTIVOS=true
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Solo si IA_PROVEEDOR=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
