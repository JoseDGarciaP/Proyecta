# Copia este archivo como deploy/.env.produccion en el servidor y llena los valores.
# Nunca lo subas a GitHub (.gitignore ya lo excluye).

# Dirección pública, sin https:// (p. ej. proyecta-ufpso.duckdns.org)
DOMINIO=

# Genera ambas con:  openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

# Correo para los enlaces de confirmación (Gmail + contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=Proyecta <tu-correo@gmail.com>

# Botón "Continuar con Google" (ID de cliente OAuth; agrega https://DOMINIO como origen autorizado)
GOOGLE_CLIENT_ID=

# IA para "Analizar": groq (gratis, https://console.groq.com/keys) u ollama (local, con --profile ollama)
IA_PROVEEDOR=groq
GROQ_API_KEY=

# Dominios permitidos para estudiantes/docentes (separados por coma)
ALLOWED_EMAIL_DOMAINS=ufpso.edu.co
